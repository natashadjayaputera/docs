<style>
  body {
    margin: 0;
    color: #000;
    font: 11pt / 15.75pt "Times New Roman", "Liberation Serif", serif;
  }

  .cv {
    box-sizing: border-box;
    max-width: 600pt;
    margin-inline: auto;
    padding: 38pt clamp(16pt, 8vw, 72pt);
  }

  h1, h2, h3, p, ul, address {
    margin: 0;
  }

  h1 {
    position: relative;
    top: 1.25pt;
    margin-bottom: 13pt;
    text-align: center;
    font-size: 13pt;
    line-height: 16pt;
  }

  h2, h3, address, .dated, .company {
    font-size: inherit;
    line-height: 13.5pt;
  }

  address {
    font-style: normal;
  }

  a {
    color: inherit;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  a:hover, a:focus-visible {
    text-decoration: underline;
  }

  section {
    margin-top: 13.5pt;
  }

  h2 {
    position: relative;
    padding-bottom: 3pt;
  }

  h2::after {
    position: absolute;
    right: 3pt;
    bottom: 2pt;
    left: 3pt;
    border-bottom: 0.75pt solid #888;
    content: "";
  }

  .summary p, .skills ul {
    margin-top: 4pt;
  }

  .summary p {
    text-align: justify;
  }

  .dated {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    column-gap: 8pt;
    padding-right: 3.75pt;
  }

  .company, .projects h3 {
    margin-bottom: 3pt;
  }

  article + article, .hobby {
    margin-top: 10.75pt;
  }

  ul {
    padding-left: 21pt;
    list-style: none;
  }

  li {
    position: relative;
  }

  li::before {
    position: absolute;
    left: -18pt;
    content: "●";
    font-family: Arial, sans-serif;
  }

  ul ul {
    padding-left: 21.75pt;
  }

  .keep-together {
    white-space: nowrap;
  }

  li li::before {
    content: "○";
  }

  @media screen and (max-width: 500px) {
    .summary p {
      text-align: start;
    }
  }

  @media print {
    @page {
      size: A4;
      margin: 63.25pt 67pt 33pt 72pt;
    }

    @page :first {
      margin-top: 69pt;
    }

    .cv {
      max-width: none;
      padding: 0;
    }

    .print-continuation {
      break-before: page;
    }

    .projects {
      margin-top: 27.75pt;
    }
  }
</style>
